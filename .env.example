# Nivara environment configuration

# Backend
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:3002","http://127.0.0.1:3002"]

# Database
DATABASE_URL=postgresql+asyncpg://nivara:nivara@localhost:5432/nivara

# Map provider
MAP_API_KEY=

# Routing provider (server-side only)
ROUTING_PROVIDER=openrouteservice
ROUTING_API_KEY=
ROUTE_CORRIDOR_RADIUS_METERS=100
DEVIATION_CORRIDOR_THRESHOLD_METERS=500

# AI provider
AI_API_KEY=

# Notifications
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
